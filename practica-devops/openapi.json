{
  "openapi": "3.1.0",
  "info": {
    "title": "Nexa API de práctica DevOps",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "CategoryInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      },
      "ProductInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "category_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "name",
          "price_cents",
          "category_id"
        ],
        "additionalProperties": false
      },
      "ClearInput": {
        "type": "object",
        "properties": {
          "confirmation": {
            "type": "string",
            "const": "VACIAR"
          }
        },
        "required": [
          "confirmation"
        ],
        "additionalProperties": false
      },
      "Category": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      },
      "Product": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "pattern": "\\S"
          },
          "price_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "category_id": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "price_cents",
          "category_id"
        ],
        "additionalProperties": false
      },
      "Health": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Backend cargado correctamente"
          },
          "service": {
            "type": "string"
          },
          "database": {
            "type": "string"
          }
        },
        "required": [
          "message",
          "service",
          "database"
        ],
        "additionalProperties": false
      },
      "Backup": {
        "type": "object",
        "properties": {
          "filename": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "filename",
          "bytes"
        ],
        "additionalProperties": false
      },
      "Cleared": {
        "type": "object",
        "properties": {
          "deleted_products": {
            "type": "integer",
            "minimum": 0
          },
          "deleted_categories": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "deleted_products",
          "deleted_categories"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "AdminToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Admin-Token"
      }
    }
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Estado del servicio",
        "responses": {
          "200": {
            "description": "Mensaje de estado en JSON",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer",
                      "example": 200
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "message": {
                            "type": "string",
                            "example": "cat"
                          }
                        },
                        "required": [
                          "message"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "statusCode",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "default": {
            "description": "Error",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "integer",
                      "minimum": 100,
                      "maximum": 599
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Error"
                      }
                    }
                  },
                  "required": [
                    "statusCode",
                    "data"
                  ],
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
