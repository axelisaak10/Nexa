            "key": "X-Admin-Token",
            "value": "{{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/products/{{productId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test(\"Envoltura JSON\", () => { pm.expect(json.statusCode).to.eql(pm.response.code); pm.expect(json.data).to.be.an(\"array\"); pm.expect(Object.keys(json).sort()).to.eql([\"data\",\"statusCode\"]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "9. Eliminar categoría sin productos",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Admin-Token",
            "value": "{{adminToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/categories/{{categoryId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test(\"Envoltura JSON\", () => { pm.expect(json.statusCode).to.eql(pm.response.code); pm.expect(json.data).to.be.an(\"array\"); pm.expect(Object.keys(json).sort()).to.eql([\"data\",\"statusCode\"]); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10. Vaciar datos conservando estructura",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "X-Admin-Token",
            "value": "{{adminToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/database",
        "body": {
          "mode": "raw",
          "raw": "{\"confirmation\":\"VACIAR\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "const json = pm.response.json();",
              "pm.test(\"Envoltura JSON\", () => { pm.expect(json.statusCode).to.eql(pm.response.code); pm.expect(json.data).to.be.an(\"array\"); pm.expect(Object.keys(json).sort()).to.eql([\"data\",\"statusCode\"]); });"
            ]
          }
        }
      ]
    }
  ]
}
